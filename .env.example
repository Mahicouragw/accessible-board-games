# ============================================================================
# HeroBoard — environment configuration
# Copy to `.env` (or set your host's environment variables).
#
# The app runs fully OFFLINE / LOCAL with no credentials at all (pass-and-play
# and same-device rooms work out of the box). Fill the two Supabase values
# below to enable real cross-device multiplayer via Supabase Postgres + Realtime.
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The public anon key (safe to expose in a browser; guarded by RLS).
VITE_SUPABASE_ANON_KEY=

# ---- How the frontend reads these ----
# Create `js/config.js` (or set window.HEROBOARD_CONFIG) from these values.
# Example:
#   window.HEROBOARD_CONFIG = {
#     supabaseUrl: "VITE_SUPABASE_URL_VALUE",
#     supabaseAnonKey: "VITE_SUPABASE_ANON_KEY_VALUE"
#   }
# Then run / deploy the static folder (index.html + js/ + styles.css).
